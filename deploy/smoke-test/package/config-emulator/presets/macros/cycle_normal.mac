# Правило: любой дискретный SET-затем-clear (импульс) должен держаться минимум ~3x pollIntervalMs
# (сэмпл-конфиг использует 200мс -> держать фронт ≥600мс), иначе периодический опрос коннектора
# может ни разу не увидеть true между двумя соседними SyncFromBank (см. STATE_MACHINE.md, rising edge).
# То же правило применимо к аналоговой "подушке" (минимум InjectionPosition): RAMP до минимума
# должен выдержать дно ≥3x pollIntervalMs (≥600мс) неподвижно, прежде чем идти обратно вверх -
# иначе значение подушки, наблюдаемое опросом, — чистая случайность фазы (см. Important-3).

# Пресет описывает цикл литья, выполняющийся штатно
# Длительность цикла примерно 46 секунд
# Подушка 1200 мВ

# Начальная конфигурация сигналов
# ====
# пресс-форма разомкнута
AT 0     SET MoldClosed 0
AT 0     SET MoldOpened 1
# выталкиватель
AT 0     SET FwdEjectorReached 0
AT 0     SET BwdEjectorReached 0
# впрыска нет
AT 0     SET Injection 0
# положение подвижной плиты = 10000 мВ
AT 0     SET MoldPosition 10000.0
# положение шнека = 8000 мВ
AT 0     SET InjectionPosition 8000.0
# ====
# Закрытие пресс-формы
# ====
# через секунду после начала выполнения макроса запускается цикл
AT 1000  SET MoldOpened 0
# плита плавно движется к позиции 0 (полному смыканию) за 3000 мс
AT 1000  RAMP MoldPosition 0.0 3000
# Пресс-форма сомкнулась
AT 4000  SET MoldClosed 1
# набирается усилие смыкания - 3 секунды
#AT 7000  SET MoldClosed 1 - закомментировал, т.к. конфликтует по времени с SET Injection 1
# ====
# Впрыск
# ====
# начался впрыск
AT 7000  SET Injection 1
# шнек подаётся вперёд в положение 1500 мВ за 2000 мс
AT 7000  RAMP InjectionPosition 1500.0 2000
# ====
# Выдержка
# ====
# шнек удерживает давление - доползает немного вперёд за 4 секунды
AT 9000  RAMP InjectionPosition 1200.0 4000
# ====
# Охлаждение
# ====
# впрыск закончился
# после RAMP дно 1200 мВ держится 600 мс (13000..13600), затем шнек идёт назад
AT 13600 SET Injection 0
# шнек подаётся назад за 24400 мс; время открытия формы не меняется
AT 13600 RAMP InjectionPosition 8000.0 24400
# ====
# Открытие пресс-формы
# ====
AT 38000 SET MoldClosed 0
# плита движется к крайнему положению за 5 секунд
AT 38000 RAMP MoldPosition 10000.0 5000
# открылась
AT 43000 SET MoldOpened 1
# ====
# Выгрузка изделия
# ====
AT 45000 SET FwdEjectorReached 1
AT 45400 SET FwdEjectorReached 0
AT 47000 SET BwdEjectorReached 1
AT 47400 SET BwdEjectorReached 0
