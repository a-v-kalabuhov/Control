# Скопировать в ~/wtctrl-demo/.env на VPS (в git не хранится).
# Пароль — только буквы и цифры: он подставляется в строку подключения и в интерполяцию compose,
# символы ; = $ её ломают.
DB_PASSWORD=смените-на-длинный-пароль
# Общий тег образов API и migrations — deploy.ps1 выставляет его при каждом деплое
APP_VERSION=latest
# Только для локальной проверки пакета (на VPS не задавать — там 80/443):
# HTTP_PORT=18080
# HTTPS_PORT=18443
